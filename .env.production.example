APP_NAME="Maha Construction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ════════════════════════════════════════════════════════════════════════════════
# DATABASE PERSISTENCE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# Option A: SQLite with Persistent Disk (Default on Render / Fly.io / Docker volume)
# When a persistent disk is mounted at /var/www/html/public/uploads, the SQLite file
# is safely kept in /var/www/html/public/uploads/.data/database.sqlite and survives all deployments.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/public/uploads/.data/database.sqlite
DB_SEED_ON_BOOT=false

# Option B: Managed PostgreSQL (e.g. Supabase, Neon, Render Postgres, AWS RDS)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=maha_construction
# DB_USERNAME=postgres
# DB_PASSWORD=your_strong_db_password

# Option C: Managed MySQL / MariaDB (e.g. AWS RDS, DigitalOcean, PlanetScale, Railway)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maha_construction
# DB_USERNAME=maha_user
# DB_PASSWORD=your_strong_db_password

# ════════════════════════════════════════════════════════════════════════════════
# STORAGE & UPLOADS CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# Default: Local persistent volume (Render Disk / Fly Volume / Docker Mount)
FILESYSTEM_DISK=public

# Optional: Cloud Object Storage (Amazon S3 / Cloudflare R2 / MinIO / DigitalOcean)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=maha-uploads
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.your-domain.com

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Admin Credentials for Initial Database Seeding
ADMIN_EMAIL=Mahaconstructions2013@gmail.com
ADMIN_PASSWORD=SetAStrongPasswordHere2026!

# YouTube Integration (Optional API key for guaranteed quota-free live sync)
YOUTUBE_API_KEY=
