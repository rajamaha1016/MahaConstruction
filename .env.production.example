APP_NAME="Maha Construction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (Choose SQLite, MySQL, or PostgreSQL)
# Option A: SQLite (Default)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
DB_SEED_ON_BOOT=true

# Option B: Managed MySQL / MariaDB (e.g. AWS RDS, DigitalOcean, PlanetScale)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maha_construction
# DB_USERNAME=maha_user
# DB_PASSWORD=your_strong_db_password

# Option C: Managed PostgreSQL (e.g. Supabase, Neon, Render Postgres)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=maha_construction
# DB_USERNAME=postgres
# DB_PASSWORD=your_strong_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Admin Credentials for Initial Database Seeding
ADMIN_EMAIL=Mahaconstructions2013@gmail.com
ADMIN_PASSWORD=SetAStrongPasswordHere2026!

# YouTube Integration (Optional API key for guaranteed quota-free live sync)
YOUTUBE_API_KEY=
