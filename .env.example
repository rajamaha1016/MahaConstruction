APP_NAME="Maha Construction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://web-production-8d2af.up.railway.app

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maha_construction
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional: YouTube Data API v3 key for reliable channel sync (RSS works without this)
YOUTUBE_API_KEY=

# Official Admin Email (used for authentication & password recovery)
ADMIN_EMAIL=mahaconstructions2013@gmail.com

# Mail Configuration
# Local Development: Logs emails to storage/logs/laravel.log (No emails sent to Gmail)
MAIL_MAILER=log

# Production (Gmail SMTP): Set APP_ENV=production and configure Gmail SMTP credentials
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=mahaconstructions2013@gmail.com
# MAIL_PASSWORD=your_gmail_app_password
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="mahaconstructions2013@gmail.com"
# MAIL_FROM_NAME="Maha Construction Admin"
