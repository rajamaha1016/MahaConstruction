APP_NAME="Maha Construction"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set APP_URL to your actual production domain. All reset links and asset URLs derive from this.
# Example: https://mahaconstruction.com
APP_URL=https://your-production-domain.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────────────────────────────
# SQLite (simple, needs persistent volume) — or switch to MySQL/Postgres below
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maha_construction
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_db_password

# ── Cache / Session / Queue ───────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── File Storage ──────────────────────────────────────────────────────────────────────
# local  → files go to public/uploads/ (ephemeral on containers — use a volume or S3)
# s3     → files go to S3-compatible object storage (persistent, recommended for production)
FILESYSTEM_DISK=local

# S3-compatible object storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO)
# Leave AWS_ENDPOINT empty for native AWS S3.
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket-name
# AWS_ENDPOINT=https://your-endpoint-if-not-aws
# AWS_URL=https://your-cdn-or-bucket-public-url

# ── Admin Account ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=your_admin_email@example.com
# ADMIN_PASSWORD=your_initial_admin_password   # used only at first seed

# ── YouTube (optional) ────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ── Mail / SMTP ───────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT: set MAIL_MAILER=log to prevent real email dispatch
# PRODUCTION:        set MAIL_MAILER=smtp and configure real SMTP credentials
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your_gmail_address@gmail.com"
MAIL_FROM_NAME="Maha Construction Admin"

# ── Seeding ───────────────────────────────────────────────────────────────────────────
# Set to true ONLY for a fresh deployment to seed initial data.
# NEVER set to true on a live production instance with real data.
DB_SEED_ON_BOOT=false
