# Disable script execution in the uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|sh|pl|cgi|exe|bat|cmd)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
